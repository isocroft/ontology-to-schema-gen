# ---------------------------------------------------------------------------
# Go Binaries & Compiled Outputs
# ---------------------------------------------------------------------------
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled main binaries (if you name your binary the same as your project)
# It's often safer to output binaries to a specific directory like bin/
bin/
dist/
out/

# ---------------------------------------------------------------------------
# Test & Coverage Artifacts
# ---------------------------------------------------------------------------
# Test binaries (generated by 'go test -c')
*.test

# Code coverage profiles
*.out
*.coverprofile
profile.cov

# ---------------------------------------------------------------------------
# Go Workspaces & Modules
# ---------------------------------------------------------------------------
# Go workspace files (used for local development across multiple modules)
go.work
go.work.sum

# Vendor directory 
# Un-comment the line below if you prefer NOT to commit your vendored dependencies.
# vendor/

# ---------------------------------------------------------------------------
# Environment Variables & Secrets
# ---------------------------------------------------------------------------
# Contains sensitive API keys, passwords, and local configurations
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Operating System & IDE Files
# ---------------------------------------------------------------------------
# macOS
.DS_Store

# Windows
Thumbs.db

# ---------------------------------------------------------------------------
# IDE Settings Folder(s)
# ---------------------------------------------------------------------------
# JetBrains / GoLand / IntelliJ
.idea/

# Visual Studio Code
.vscode/
